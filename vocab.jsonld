  },
  "@graph": [
    {
      "@id": "https://w3id.org/aget/vocab",
      "@type": "skos:ConceptScheme",
      "skos:prefLabel": {
        "@value": "AGET Framework Vocabulary",
        "@language": "en"
      },
      "dcterms:license": {
        "@id": "https://www.apache.org/licenses/LICENSE-2.0"
      },
      "dcterms:creator": "AGET framework (github.com/aget-framework)",
      "dcterms:issued": "2026-07-11",
      "dcterms:modified": "2026-09-23",
      "vann:preferredNamespacePrefix": "aget",
      "vann:preferredNamespaceUri": "https://w3id.org/aget/vocab#",
      "dcterms:provenance": "aget-publish-engine; emission-rule v2"
    },
    {
      "@id": "aget:Learning_Document",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Learning Document",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A structured, persistent, searchable document that captures a single durable lesson extracted from operational experience, classified for reuse either by other agents (framework lessons) or by the human principal (domain lessons). Functions as a unit of organizational memory that persists beyond ephemeral session context; designed for accretion \u2014 many small cross-linked documents rather than monolithic reports.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "L-doc",
          "@language": "en"
        },
        {
          "@value": "Lesson-Learned Document",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "An agent records a lesson that publication-forum decisions are not publication- standard adoptions, and later sessions cite it before designing a publishing capability.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Software_Session"
        }
      ],
      "foaf:isPrimaryTopicOf": {
        "@id": "https://www.gabormelli.com/RKB/Learning_Document"
      },
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Agent_Fleet",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Agent Fleet",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A bounded set of software agents operating under shared governance, typically with one supervising agent and multiple worker agents. A fleet shares configuration standards, session protocols, and a common upgrade lifecycle while each member retains its own domain scope and memory.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "Fleet",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "A fleet supervisor coordinates version upgrades across its worker agents and verifies each member's deployment before closing a release cycle.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Initialization_Protocol"
        }
      ],
      "foaf:isPrimaryTopicOf": {
        "@id": "https://www.gabormelli.com/RKB/Agent_Fleet"
      },
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Software_Session",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Software Session",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A bounded interval of interactive or autonomous software operation with a defined start and end, its own working context, and lifecycle protocols that establish and wind down that context. For collaborative agents, the session is the unit within which context is loaded, work is performed, and durable artifacts are handed off.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "Agent Session",
          "@language": "en"
        },
        {
          "@value": "Work Session",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "An agent session opens with an initialization protocol that loads identity and pending work, and closes by writing a handoff file for the next session.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Initialization_Protocol"
        },
        {
          "@id": "aget:Learning_Document"
        }
      ],
      "foaf:isPrimaryTopicOf": {
        "@id": "https://www.gabormelli.com/RKB/Software_Session"
      },
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Initialization_Protocol",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Initialization Protocol",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A defined startup ritual that loads an agent's identity, version, governing constraints, and pending work into operating context before substantive work begins. Ensures each operating interval starts from verified state rather than assumptions; the counterpart termination protocol performs structured closure and handoff.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "Wake-Up Protocol",
          "@language": "en"
        },
        {
          "@value": "Session Initialization",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "On \"wake up\", an agent runs its initialization protocol: read identity and version, verify governance is loaded, list active work, report readiness.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Software_Session"
        }
      ],
      "foaf:isPrimaryTopicOf": {
        "@id": "https://www.gabormelli.com/RKB/Initialization_Protocol"
      },
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Verification_Test",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Verification Test",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "An executable check paired with a requirement or deliverable that returns pass or fail, distinguishing verified completion from declared completion. Verification tests gate stage boundaries: work is complete when its test passes, not when its author asserts completion.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "V-Test",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "A release gate requires each advertised capability to pass its verification test \u2014 an executable command whose output confirms the artifact exists and behaves as claimed \u2014 before the release tag is created.",
        "@language": "en"
      },
      "foaf:isPrimaryTopicOf": {
        "@id": "https://www.gabormelli.com/RKB/Verification_Test"
      },
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Aget_Agent",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Aget Agent",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A configured software agent instance built on the AGET framework, combining an identity (purpose, scope, governing constraints), persistent memory, skill-based capabilities, and session lifecycle protocols. Instantiated from an agent template repository and operated in collaboration with a human principal who holds decision authority over irreversible acts.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "AGET Agent",
          "@language": "en"
        },
        {
          "@value": "AGET Instance",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "A framework-manager agent instance that stewards a public repository: it wakes with its identity and pending work, executes gated plans, and records lessons for future sessions.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Agent_Fleet"
        },
        {
          "@id": "aget:Agent_Template_Repository"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Termination_Protocol",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Termination Protocol",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A defined closure ritual that ends an agent's operating interval in a recoverable state: verifying health, capturing pending work, recording session artifacts, and preparing handoff context so the next interval can resume without loss. The counterpart of an initialization protocol.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "Wind-Down Protocol",
          "@language": "en"
        },
        {
          "@value": "Session Closure Protocol",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "On \"wind down\", an agent checks for uncommitted changes and open plans, writes a session summary with handoff notes, and reports what the next session should pick up.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Initialization_Protocol"
        },
        {
          "@id": "aget:Software_Session"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Agent_Capability",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Agent Capability",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A named, scoped, testable ability of a software agent, expressed as formal requirements with executable verification. Distinct from a capability measure (an assessment of how well a system performs): an agent capability is a specified, versioned artifact whose presence and behavior can be verified by test rather than asserted.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "Capability Artifact",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "A session-management capability specified as requirements with paired verification tests, such that an upgrade can prove the capability still holds before deployment.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Verification_Test"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Agent_Template_Repository",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Agent Template Repository",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A published, version-controlled repository defining an agent archetype from which agent instances are instantiated, carrying baseline skills, capabilities, session protocols, and governance configuration. Distinct from an agent design pattern (a reusable architectural solution): a template repository is an instantiable artifact with a version lifecycle.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "Agent Archetype Repository",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "A developer archetype repository that new coding agents are created from, inheriting its session protocols and baseline skills, then diverging with instance-specific memory and scope.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Aget_Agent"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Agent_Skill",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Agent Skill",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A named, documented, invocable unit of agent procedure \u2014 instructions, constraints, and optional supporting scripts \u2014 that an agent loads on demand to perform a recurring task in a governed way. Skills are versioned artifacts with declared triggers, distinct from the agent's ambient instructions: they encapsulate one procedure behind one name.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "Skill Artifact",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "A record-lesson skill that an agent invokes to capture a durable learning with consistent structure, classification, and traceability.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Slash_Command"
        },
        {
          "@id": "aget:Agent_Capability"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Slash_Command",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Slash Command",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A user-invocable command addressed by a leading slash (such as /review or /deploy) inside a chat, CLI, or agent interface, mapping a short memorable name to a defined procedure or prompt. In agentic coding tools, slash commands are the common invocation surface for agent skills.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:example": {
        "@value": "Typing /wake-up in an agent CLI invokes the session initialization skill; typing /review in a chat tool triggers a code review procedure.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Agent_Skill"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Software_Hook",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Software Hook",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A defined extension point at which a software system invokes externally supplied code in response to a lifecycle event, allowing behavior to be added or intercepted without modifying the host system. In agent frameworks, hooks fire on events such as session start or before tool execution, and are the structural surface for tracing and access control.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "Hook",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "A pre-tool-use hook that logs each consultation and denies callers not on an allowlist, enforcing policy even when higher-level configuration is inert.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Agent_Skill"
        }
      ],
      "foaf:isPrimaryTopicOf": {
        "@id": "https://www.gabormelli.com/RKB/Software_Hook"
      },
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Executable_Knowledge_Ontology",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Executable Knowledge Ontology",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A structured vocabulary that classifies knowledge artifacts by how executable they are, organizing them along axes such as abstraction level (from algorithm to concrete execution), determinism, and reusability. Bridges documentation and automation: entries are classified by whether a machine can act on them directly, with parameters, or only via human interpretation.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "EKO",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "Classifying a deployment procedure as parameterized-executable (a script with inputs) versus a design rationale as human-interpretable knowledge.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Learning_Document"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Session_Protocol",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Session Protocol",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A defined, repeatable procedure governing a phase of a software session's lifecycle \u2014 initialization, checkpointing, health verification, or termination \u2014 so that session state transitions are performed by rule rather than improvisation.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:example": {
        "@value": "An agent's session protocols include a wake-up procedure, a mid-session checkpoint save, and a wind-down closure with handoff.",
        "@language": "en"
      },
      "skos:broader": [
        {
          "@id": "aget:Software_Session"
        }
      ],
      "skos:related": [
        {
          "@id": "aget:Initialization_Protocol"
        },
        {
          "@id": "aget:Termination_Protocol"
        }
      ]
    },
    {
      "@id": "aget:Software_Specification",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Software Specification",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A contract-level document that formalizes intended software behavior as testable, enforceable requirements, typically in a controlled syntax with unique requirement identifiers and paired verification tests. In a two-level model, specifications formalize human-level requirements; when behavior fails, the specification is examined first, since code can correctly implement a wrong specification.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:example": {
        "@value": "A session-lifecycle specification whose requirements each carry an identifier, a controlled-syntax statement, and an executable verification test.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Verification_Test"
        },
        {
          "@id": "aget:Agent_Capability"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:AGET_Framework",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "AGET Framework",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A configuration and lifecycle management framework for CLI-based human-AI collaborative coding agents, providing agent identity, persistent memory, skill- based capabilities, session protocols, template repositories, and governance constraints with approval gates. Distributed as a public reference implementation with instantiable agent templates.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "AGET",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "An engineer instantiates a worker agent from an AGET template, and the agent thereafter wakes, works within gated plans, records lessons, and winds down under the framework's session protocols.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Aget_Agent"
        },
        {
          "@id": "aget:Agent_Template_Repository"
        },
        {
          "@id": "aget:Agent_Fleet"
        }
      ],
      "foaf:isPrimaryTopicOf": {
        "@id": "https://www.gabormelli.com/RKB/AGET_Framework"
      },
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Ontology_CI_Gate",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Ontology CI Gate",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A check that runs a controlled vocabulary's quality validators automatically on every proposed change, and blocks the change from being merged when a validator reports a defect. Without it, validation depends on someone remembering to run it, so a vocabulary can accumulate defects indefinitely while each individual change is believed to have been checked \u2014 the belief and the measurement drift apart with nothing to reconcile them.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "Continuous Validation Gate",
          "@language": "en"
        },
        {
          "@value": "Pre-Merge Ontology Check",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "A project keeps a link validator in its repository and runs it by hand at the end of each expansion cycle. Between cycles the vocabulary is unmeasured, and a defect introduced early is found only when someone next remembers. Wiring the same validator into the merge check converts the measurement from a habit into a precondition.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Reciprocal_Link_Validator"
        },
        {
          "@id": "aget:Author_Asserted_Cleanliness_Anti_Pattern"
        },
        {
          "@id": "aget:Reflexive_Validation_Methodology"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Denominator_Disclosure",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Denominator Disclosure",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The obligation to state the population a rate or count was computed over, at the point the figure is asserted. Naming the instrument that produced a number answers how it was measured but never what it was measured over, and the two diverge silently. An instrument can be correct and still range over the wrong set, yielding a figure that is precise, reproducible and wrong \u2014 and undetectably so, because nothing in the figure records the set it came from.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "Population Naming",
          "@language": "en"
        },
        {
          "@value": "Stated Denominator",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "A census of managed agents taken by directory pattern returned four different totals on four occasions, each defensible from its own listing and none matching the authoritative register. The instrument was not at fault. No figure had stated the set it ranged over, so no two of them could be compared, and the disagreement went unnoticed.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Author_Asserted_Cleanliness_Anti_Pattern"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Reciprocal_Link_Validator",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Reciprocal Link Validator",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A validator that checks whether the associative and hierarchical links in a concept scheme are declared symmetrically: that every concept named as related by another names it in return, and that every broader link has a matching narrower link on the parent it points to. It exists to catch the dominant failure mode of vocabularies maintained by addition, where a new concept is linked forward to existing ones and the corresponding edits to those existing ones are never made.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "Symmetric-Link Checker",
          "@language": "en"
        },
        {
          "@value": "Three-Lane Reciprocity Validator",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "An author adds a concept and lists six existing concepts as related to it. Unless each of those six is also edited, the vocabulary asserts the relationship in one direction only, and a reader arriving from any of the six will never reach the new concept.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Ontology_CI_Gate"
        },
        {
          "@id": "aget:Forward_Only_Link_Defect"
        },
        {
          "@id": "aget:Author_Asserted_Cleanliness_Anti_Pattern"
        },
        {
          "@id": "aget:Reflexive_Validation_Methodology"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Forward_Only_Link_Defect",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Forward-Only Link Defect",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A defect in a concept scheme where a link between two concepts is declared in one direction only, because the author edited the concept being added and not the existing concepts it points at. The defect is invisible from the concept that was authored, where the work looks finished, and shows up only when the vocabulary is read from the other end. That asymmetry of visibility is why it accumulates rather than being caught.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "Asymmetric Reciprocity Defect",
          "@language": "en"
        },
        {
          "@value": "Lane-1 / Lane-2 Reciprocity Defect",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "Across six consecutive expansion cycles of one vocabulary, links between concepts in the same cluster were made symmetric while being written, and links crossing clusters were deferred to a cleanup that was never scheduled. The deferred edits grew into the vocabulary's single largest defect class.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Reciprocal_Link_Validator"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Fail_Stop_Behavior",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Fail-Stop Behavior",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A failure semantics in which a faulty component halts before producing any externally visible erroneous output, so that other components can reliably detect the failure and begin recovery. It is the strongest well-behaved failure class \u2014 detectable and non-contagious \u2014 and the property that makes a missing component safe: a check that cannot run must report that it could not run, because a silent absence reads as success.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "Fail-Stop Processor",
          "@language": "en"
        },
        {
          "@value": "Fail-Stop Failure Mode",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "An agent meeting unambiguously corrupted state halts cleanly instead of continuing and emitting plausible output derived from it. A supervisor can then trust that a halted worker sent nothing downstream. The contrasting case is arbitrary behavior, where a faulty component keeps producing output that cannot be distinguished from correct output.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Failure_Detector"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Failure_Detector",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Failure Detector",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "An abstract oracle in a distributed system that gives each process suspicion information about the others, classified by completeness (every crashed process is eventually suspected) and accuracy (correct processes are not suspected). Chandra and Toueg showed that the eventually-strong class is the weakest one that can solve consensus given a majority of correct processes, which sets a hard limit on what any supervisor can know about a worker it cannot see.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "Unreliable Failure Detector",
          "@language": "en"
        },
        {
          "@value": "Crash Detector",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "Heartbeat-based liveness checking is inherently unreliable: a timeout cannot separate a crashed process from a slow one. Any liveness claim therefore carries a false-positive rate, and an escalation policy has to handle that rate rather than assume it away.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Fail_Stop_Behavior"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Author_Asserted_Cleanliness_Anti_Pattern",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Author-Asserted Cleanliness Anti-Pattern",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A failure mode in which an author, or a tool acting on their behalf, reports a vocabulary or artifact as free of defects on the strength of confidence rather than validator output. The harm is not that the claim is often wrong but that it is indistinguishable in form from a measured one, so it displaces the measurement it stands in for: a reader downstream treats an unmade claim as a verified one, and nothing in the record distinguishes them.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "Assert-Before-Verify",
          "@language": "en"
        },
        {
          "@value": "Confidence-As-Measurement",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "A procedure ended with the author recording \"no orphans, no dangling references, all links reciprocal\". Replacing that line with a requirement to paste the validator's actual output changed the reported state on the very first run.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Ontology_CI_Gate"
        },
        {
          "@id": "aget:Reciprocal_Link_Validator"
        },
        {
          "@id": "aget:Denominator_Disclosure"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    },
    {
      "@id": "aget:Reflexive_Validation_Methodology",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Reflexive Validation Methodology",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A methodology for validating a vocabulary or a tool by turning it on itself \u2014 using the expansion procedure to expand the vocabulary that describes expansion, or the validation concepts to validate the validator. The reflexive case is diagnostic because it is the one case whose authors cannot argue is unrepresentative: a procedure that fails on its own subject matter has been falsified by the least contrived example available to it.",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "https://w3id.org/aget/vocab"
      },
      "skos:altLabel": [
        {
          "@value": "Self-Test Vocabulary Pattern",
          "@language": "en"
        },
        {
          "@value": "Tool-As-Own-Subject",
          "@language": "en"
        }
      ],
      "skos:example": {
        "@value": "A vocabulary was expanded with concepts describing validation, and its own validators were then run over the result. The defects that surfaced were in the validators' coverage rather than in the new concepts \u2014 a gap that expansions into unrelated domains had never exposed.",
        "@language": "en"
      },
      "skos:related": [
        {
          "@id": "aget:Ontology_CI_Gate"
        },
        {
          "@id": "aget:Reciprocal_Link_Validator"
        }
      ],
      "skos:topConceptOf": {
        "@id": "https://w3id.org/aget/vocab"
      }
    }
  ]
}

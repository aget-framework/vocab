@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix aget: <https://w3id.org/aget/vocab#> .

<https://w3id.org/aget/vocab> a skos:ConceptScheme ;
    skos:prefLabel "AGET Framework Vocabulary"@en ;
    skos:definition "Published concepts from the AGET framework — configuration and lifecycle management for CLI-based human-AI collaborative coding agents."@en ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dcterms:creator "AGET framework (github.com/aget-framework)" ;
    dcterms:issued "2026-07-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
    dcterms:modified "2026-09-23"^^<http://www.w3.org/2001/XMLSchema#date> ;
    vann:preferredNamespacePrefix "aget" ;
    vann:preferredNamespaceUri "https://w3id.org/aget/vocab#" ;
    dcterms:provenance "aget-publish-engine; emission-rule v2"@en .

aget:Learning_Document a skos:Concept ;
    skos:prefLabel "Learning Document"@en ;
    skos:altLabel "L-doc"@en ;
    skos:altLabel "Lesson-Learned Document"@en ;
    skos:definition "A structured, persistent, searchable document that captures a single durable lesson extracted from operational experience, classified for reuse either by other agents (framework lessons) or by the human principal (domain lessons). Functions as a unit of organizational memory that persists beyond ephemeral session context; designed for accretion — many small cross-linked documents rather than monolithic reports."@en ;
    skos:example "An agent records a lesson that publication-forum decisions are not publication- standard adoptions, and later sessions cite it before designing a publishing capability."@en ;
    skos:related aget:Software_Session ;
    foaf:isPrimaryTopicOf <https://www.gabormelli.com/RKB/Learning_Document> ;
    skos:topConceptOf <https://w3id.org/aget/vocab> ;
    skos:inScheme <https://w3id.org/aget/vocab> .

aget:Agent_Fleet a skos:Concept ;
    skos:prefLabel "Agent Fleet"@en ;
    skos:altLabel "Fleet"@en ;
    skos:definition "A bounded set of software agents operating under shared governance, typically with one supervising agent and multiple worker agents. A fleet shares configuration standards, session protocols, and a common upgrade lifecycle while each member retains its own domain scope and memory."@en ;
    skos:example "A fleet supervisor coordinates version upgrades across its worker agents and verifies each member's deployment before closing a release cycle."@en ;
    skos:related aget:Initialization_Protocol ;
    foaf:isPrimaryTopicOf <https://www.gabormelli.com/RKB/Agent_Fleet> ;
    skos:topConceptOf <https://w3id.org/aget/vocab> ;
    skos:inScheme <https://w3id.org/aget/vocab> .

aget:Software_Session a skos:Concept ;
    skos:prefLabel "Software Session"@en ;
    skos:altLabel "Agent Session"@en ;
    skos:altLabel "Work Session"@en ;
    skos:definition "A bounded interval of interactive or autonomous software operation with a defined start and end, its own working context, and lifecycle protocols that establish and wind down that context. For collaborative agents, the session is the unit within which context is loaded, work is performed, and durable artifacts are handed off."@en ;
    skos:example "An agent session opens with an initialization protocol that loads identity and pending work, and closes by writing a handoff file for the next session."@en ;
    skos:related aget:Initialization_Protocol ;
    skos:related aget:Learning_Document ;
    foaf:isPrimaryTopicOf <https://www.gabormelli.com/RKB/Software_Session> ;
    skos:topConceptOf <https://w3id.org/aget/vocab> ;
    skos:inScheme <https://w3id.org/aget/vocab> .

aget:Initialization_Protocol a skos:Concept ;
    skos:prefLabel "Initialization Protocol"@en ;
    skos:altLabel "Wake-Up Protocol"@en ;
    skos:altLabel "Session Initialization"@en ;
    skos:definition "A defined startup ritual that loads an agent's identity, version, governing constraints, and pending work into operating context before substantive work begins. Ensures each operating interval starts from verified state rather than assumptions; the counterpart termination protocol performs structured closure and handoff."@en ;
    skos:example "On "wake up", an agent runs its initialization protocol: read identity and version, verify governance is loaded, list active work, report readiness."@en ;
    skos:related aget:Software_Session ;
    foaf:isPrimaryTopicOf <https://www.gabormelli.com/RKB/Initialization_Protocol> ;
    skos:topConceptOf <https://w3id.org/aget/vocab> ;
    skos:inScheme <https://w3id.org/aget/vocab> .

aget:Verification_Test a skos:Concept ;
    skos:prefLabel "Verification Test"@en ;
    skos:altLabel "V-Test"@en ;
    skos:definition "An executable check paired with a requirement or deliverable that returns pass or fail, distinguishing verified completion from declared completion. Verification tests gate stage boundaries: work is complete when its test passes, not when its author asserts completion."@en ;
    skos:example "A release gate requires each advertised capability to pass its verification test — an executable command whose output confirms the artifact exists and behaves as claimed — before the release tag is created."@en ;
    foaf:isPrimaryTopicOf <https://www.gabormelli.com/RKB/Verification_Test> ;
    skos:topConceptOf <https://w3id.org/aget/vocab> ;
    skos:inScheme <https://w3id.org/aget/vocab> .

aget:Aget_Agent a skos:Concept ;
    skos:prefLabel "Aget Agent"@en ;
    skos:altLabel "AGET Agent"@en ;
    skos:altLabel "AGET Instance"@en ;
    skos:definition "A configured software agent instance built on the AGET framework, combining an identity (purpose, scope, governing constraints), persistent memory, skill-based capabilities, and session lifecycle protocols. Instantiated from an agent template repository and operated in collaboration with a human principal who holds decision authority over irreversible acts."@en ;
    skos:example "A framework-manager agent instance that stewards a public repository: it wakes with its identity and pending work, executes gated plans, and records lessons for future sessions."@en ;
    skos:related aget:Agent_Fleet ;
    skos:related aget:Agent_Template_Repository ;
    skos:topConceptOf <https://w3id.org/aget/vocab> ;
    skos:inScheme <https://w3id.org/aget/vocab> .

aget:Termination_Protocol a skos:Concept ;
    skos:prefLabel "Termination Protocol"@en ;
    skos:altLabel "Wind-Down Protocol"@en ;
    skos:altLabel "Session Closure Protocol"@en ;
    skos:definition "A defined closure ritual that ends an agent's operating interval in a recoverable state: verifying health, capturing pending work, recording session artifacts, and preparing handoff context so the next interval can resume without loss. The counterpart of an initialization protocol."@en ;
    skos:example "On "wind down", an agent checks for uncommitted changes and open plans, writes a session summary with handoff notes, and reports what the next session should pick up."@en ;
    skos:related aget:Initialization_Protocol ;
    skos:related aget:Software_Session ;
    skos:topConceptOf <https://w3id.org/aget/vocab> ;
    skos:inScheme <https://w3id.org/aget/vocab> .

aget:Agent_Capability a skos:Concept ;
    skos:prefLabel "Agent Capability"@en ;
    skos:altLabel "Capability Artifact"@en ;
    skos:definition "A named, scoped, testable ability of a software agent, expressed as formal requirements with executable verification. Distinct from a capability measure (an assessment of how well a system performs): an agent capability is a specified, versioned artifact whose presence and behavior can be verified by test rather than asserted."@en ;
    skos:example "A session-management capability specified as requirements with paired verification tests, such that an upgrade can prove the capability still holds before deployment."@en ;
    skos:related aget:Verification_Test ;
    skos:topConceptOf <https://w3id.org/aget/vocab> ;
    skos:inScheme <https://w3id.org/aget/vocab> .

aget:Agent_Template_Repository a skos:Concept ;
    skos:prefLabel "Agent Template Repository"@en ;
    skos:altLabel "Agent Archetype Repository"@en ;
    skos:definition "A published, version-controlled repository defining an agent archetype from which agent instances are instantiated, carrying baseline skills, capabilities, session protocols, and governance configuration. Distinct from an agent design pattern (a reusable architectural solution): a template repository is an instantiable artifact with a version lifecycle."@en ;
    skos:example "A developer archetype repository that new coding agents are created from, inheriting its session protocols and baseline skills, then diverging with instance-specific memory and scope."@en ;
    skos:related aget:Aget_Agent ;
    skos:topConceptOf <https://w3id.org/aget/vocab> ;
    skos:inScheme <https://w3id.org/aget/vocab> .

aget:Agent_Skill a skos:Concept ;
    skos:prefLabel "Agent Skill"@en ;
    skos:altLabel "Skill Artifact"@en ;
    skos:definition "A named, documented, invocable unit of agent procedure — instructions, constraints, and optional supporting scripts — that an agent loads on demand to perform a recurring task in a governed way. Skills are versioned artifacts with declared triggers, distinct from the agent's ambient instructions: they encapsulate one procedure behind one name."@en ;
    skos:example "A record-lesson skill that an agent invokes to capture a durable learning with consistent structure, classification, and traceability."@en ;
    skos:related aget:Slash_Command ;
    skos:related aget:Agent_Capability ;
    skos:topConceptOf <https://w3id.org/aget/vocab> ;
    skos:inScheme <https://w3id.org/aget/vocab> .

aget:Slash_Command a skos:Concept ;
    skos:prefLabel "Slash Command"@en ;
    skos:definition "A user-invocable command addressed by a leading slash (such as /review or /deploy) inside a chat, CLI, or agent interface, mapping a short memorable name to a defined procedure or prompt. In agentic coding tools, slash commands are the common invocation surface for agent skills."@en ;
    skos:example "Typing /wake-up in an agent CLI invokes the session initialization skill; typing /review in a chat tool triggers a code review procedure."@en ;
    skos:related aget:Agent_Skill ;
    skos:topConceptOf <https://w3id.org/aget/vocab> ;
    skos:inScheme <https://w3id.org/aget/vocab> .

aget:Software_Hook a skos:Concept ;
    skos:prefLabel "Software Hook"@en ;
    skos:altLabel "Hook"@en ;
    skos:definition "A defined extension point at which a software system invokes externally supplied code in response to a lifecycle event, allowing behavior to be added or intercepted without modifying the host system. In agent frameworks, hooks fire on events such as session start or before tool execution, and are the structural surface for tracing and access control."@en ;
    skos:example "A pre-tool-use hook that logs each consultation and denies callers not on an allowlist, enforcing policy even when higher-level configuration is inert."@en ;
    skos:related aget:Agent_Skill ;
    foaf:isPrimaryTopicOf <https://www.gabormelli.com/RKB/Software_Hook> ;
    skos:topConceptOf <https://w3id.org/aget/vocab> ;
    skos:inScheme <https://w3id.org/aget/vocab> .

aget:Executable_Knowledge_Ontology a skos:Concept ;
    skos:prefLabel "Executable Knowledge Ontology"@en ;
    skos:altLabel "EKO"@en ;
    skos:definition "A structured vocabulary that classifies knowledge artifacts by how executable they are, organizing them along axes such as abstraction level (from algorithm to concrete execution), determinism, and reusability. Bridges documentation and automation: entries are classified by whether a machine can act on them directly, with parameters, or only via human interpretation."@en ;
    skos:example "Classifying a deployment procedure as parameterized-executable (a script with inputs) versus a design rationale as human-interpretable knowledge."@en ;
    skos:related aget:Learning_Document ;
    skos:topConceptOf <https://w3id.org/aget/vocab> ;
    skos:inScheme <https://w3id.org/aget/vocab> .

aget:Session_Protocol a skos:Concept ;
    skos:prefLabel "Session Protocol"@en ;
    skos:definition "A defined, repeatable procedure governing a phase of a software session's lifecycle — initialization, checkpointing, health verification, or termination — so that session state transitions are performed by rule rather than improvisation."@en ;
    skos:example "An agent's session protocols include a wake-up procedure, a mid-session checkpoint save, and a wind-down closure with handoff."@en ;
    skos:broader aget:Software_Session ;
    skos:related aget:Initialization_Protocol ;
    skos:related aget:Termination_Protocol ;
    skos:inScheme <https://w3id.org/aget/vocab> .

aget:Software_Specification a skos:Concept ;
    skos:prefLabel "Software Specification"@en ;
    skos:definition "A contract-level document that formalizes intended software behavior as testable, enforceable requirements, typically in a controlled syntax with unique requirement identifiers and paired verification tests. In a two-level model, specifications formalize human-level requirements; when behavior fails, the specification is examined first, since code can correctly implement a wrong specification."@en ;
    skos:example "A session-lifecycle specification whose requirements each carry an identifier, a controlled-syntax statement, and an executable verification test."@en ;
    skos:related aget:Verification_Test ;
    skos:related aget:Agent_Capability ;
    skos:topConceptOf <https://w3id.org/aget/vocab> ;
    skos:inScheme <https://w3id.org/aget/vocab> .

aget:AGET_Framework a skos:Concept ;
    skos:prefLabel "AGET Framework"@en ;
    skos:altLabel "AGET"@en ;
    skos:definition "A configuration and lifecycle management framework for CLI-based human-AI collaborative coding agents, providing agent identity, persistent memory, skill- based capabilities, session protocols, template repositories, and governance constraints with approval gates. Distributed as a public reference implementation with instantiable agent templates."@en ;
    skos:example "An engineer instantiates a worker agent from an AGET template, and the agent thereafter wakes, works within gated plans, records lessons, and winds down under the framework's session protocols."@en ;
    skos:related aget:Aget_Agent ;
    skos:related aget:Agent_Template_Repository ;
    skos:related aget:Agent_Fleet ;
    foaf:isPrimaryTopicOf <https://www.gabormelli.com/RKB/AGET_Framework> ;
    skos:topConceptOf <https://w3id.org/aget/vocab> ;
    skos:inScheme <https://w3id.org/aget/vocab> .
